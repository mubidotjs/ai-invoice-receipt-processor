{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ai-invoice-receipt-processor",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-11",
  "workers_dev": false,
  "account_id": "29253e8d409d4b73b02cb4223693ca02",
  "vars": {
    "LIVE_AI_ENABLED": "false",
    "ABUSE_CONTROLS_VERIFIED": "false",
    "ALLOWED_ORIGINS": "http://127.0.0.1:5401",
    "TURNSTILE_HOSTNAMES": "",
  },
  "observability": { "enabled": false },
  "env": {
    "production": {
      "name": "ai-invoice-receipt-processor",
      "workers_dev": true,
      "vars": {
        "LIVE_AI_ENABLED": "false",
        "ABUSE_CONTROLS_VERIFIED": "false",
        "ALLOWED_ORIGINS": "https://invoice.mubashirhussain.dev,https://ai-invoice-receipt-processor.vercel.app",
        "TURNSTILE_HOSTNAMES": "invoice.mubashirhussain.dev,ai-invoice-receipt-processor.vercel.app",
      },
      "ai": { "binding": "AI" },
      "unsafe": {
        "bindings": [
          {
            "name": "VISITOR_LIMITER",
            "type": "ratelimit",
            "namespace_id": "12001",
            "simple": { "limit": 2, "period": 60 },
          },
          {
            "name": "AGGREGATE_LIMITER",
            "type": "ratelimit",
            "namespace_id": "12002",
            "simple": { "limit": 5, "period": 60 },
          },
        ],
      },
    },
  },
}
